[Unit]
Description=Private TLScontact appointment notification monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tlsbot
Group=tlsbot
WorkingDirectory=/opt/tlsbot
ExecStart=/opt/tlsbot/.venv/bin/python /opt/tlsbot/main.py
Environment=PYTHONUNBUFFERED=1
Environment=HEADLESS=true
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/tlsbot/browsers
Environment=STATE_FILE=/var/lib/tlsbot/alerts.json
Environment=CLIENTS_FILE=/var/lib/tlsbot/clients.enc
Environment=CLIENTS_KEY_FILE=/var/lib/tlsbot/clients.key
StateDirectory=tlsbot
StateDirectoryMode=0700
Restart=on-failure
RestartSec=60
MemoryAccounting=true
CPUAccounting=true
OOMPolicy=stop
RestartPreventExitStatus=2
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

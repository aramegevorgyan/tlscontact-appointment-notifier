# Replace REPLACE_* values locally before running. Never commit real credentials.
# Single-account credentials (not needed for agency or Telegram-only mode).
TLS_EMAIL=REPLACE_WITH_YOUR_TLSCONTACT_EMAIL
TLS_PASSWORD=REPLACE_WITH_YOUR_TLSCONTACT_PASSWORD
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
ALLOWED_TELEGRAM_USER_ID=REPLACE_WITH_YOUR_NUMERIC_TELEGRAM_USER_ID
TARGET_DATE=REPLACE_WITH_FUTURE_YYYY_MM_DD

# Verified HTTPS portal URLs; calendar must belong to the account.
TLS_LOGIN_URL=REPLACE_WITH_TLSCONTACT_HTTPS_LOGIN_URL
TLS_APPOINTMENT_URL=REPLACE_WITH_YOUR_TLSCONTACT_HTTPS_CALENDAR_URL

# Playwright selectors verified against your actual portal.
TLS_EMAIL_SELECTOR=REPLACE_WITH_EMAIL_INPUT_SELECTOR
TLS_PASSWORD_SELECTOR=REPLACE_WITH_PASSWORD_INPUT_SELECTOR
TLS_SUBMIT_SELECTOR=REPLACE_WITH_LOGIN_SUBMIT_SELECTOR
TLS_COOKIE_SELECTOR=
TLS_AUTHENTICATED_SELECTOR=REPLACE_WITH_LOGGED_IN_INDICATOR_SELECTOR
TLS_READY_SELECTOR=REPLACE_WITH_CALENDAR_LOADED_SELECTOR
TLS_SLOT_SELECTOR=REPLACE_WITH_AVAILABLE_SLOT_SELECTOR
TLS_EMPTY_SELECTOR=REPLACE_WITH_NO_APPOINTMENTS_MESSAGE_SELECTOR

# Generic defaults; adjust date extraction to match the portal.
SLOT_DATE_ATTRIBUTE=data-date
SLOT_DATE_FORMAT=%Y-%m-%d
CHECK_INTERVAL=900
MAX_BACKOFF=21600
BROWSER_TIMEOUT_MS=45000
HEADLESS=true
STATE_FILE=state/alerts.json
CLIENTS_FILE=state/clients.enc
CLIENTS_KEY_FILE=state/clients.key
